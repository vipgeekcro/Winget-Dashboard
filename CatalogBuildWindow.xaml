<Window x:Class="WingetDashboard.CatalogBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winget Dashboard"
        Width="520"
        Height="190"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ThemeMode="System">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Text="Creating Winget catalog. Please wait. This may take several minutes."
                   TextWrapping="Wrap"
                   FontSize="16"
                   AutomationProperties.Name="Creating Winget catalog. Please wait. This may take several minutes." />

        <ProgressBar x:Name="ProgressIndicator" Grid.Row="1"
                     Margin="0,24,0,0"
                     Height="18"
                     IsIndeterminate="True"
                     IsTabStop="False"
                     AutomationProperties.Name="Creating Winget catalog" />
    </Grid>
</Window>
