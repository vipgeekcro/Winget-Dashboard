<Window x:Class="WingetDashboard.ProgramDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Program Details"
        Width="760"
        Height="650"
        WindowStartupLocation="CenterScreen"
        Loaded="ProgramDetailsWindow_Loaded"
        PreviewKeyDown="ProgramDetailsWindow_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="NameValue" Grid.Row="0" Text="{Binding NameDisplay}" Focusable="True" Margin="0,0,0,8"/>
        <TextBlock x:Name="VersionValue" Grid.Row="1" Text="{Binding VersionDisplay}" Focusable="True" Margin="0,0,0,8"/>
        <TextBlock x:Name="PublisherValue" Grid.Row="2" Text="{Binding PublisherDisplay}" Focusable="True" Margin="0,0,0,8"/>
        <TextBlock x:Name="PackageIdValue" Grid.Row="3" Text="{Binding PackageIdDisplay}" Focusable="True" Margin="0,0,0,8"/>
        <TextBlock x:Name="ShortDescriptionValue" Grid.Row="4" Text="{Binding ShortDescriptionDisplay}" Focusable="True" TextWrapping="Wrap" MinHeight="55" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8" Focusable="False">
            <TextBlock x:Name="DescriptionValue" Text="{Binding DescriptionDisplay}" Focusable="True" TextWrapping="Wrap"/>
        </ScrollViewer>
        <TextBlock x:Name="LicenseValue" Grid.Row="6" Text="{Binding LicenseDisplay}" Focusable="True" Margin="0,0,0,8"/>
        <TextBlock x:Name="WebsiteValue" Grid.Row="7" Text="{Binding WebsiteDisplay}" Focusable="True" TextWrapping="Wrap" MinHeight="55" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenWebsiteButton" Content="Open Web Page" MinWidth="130" Height="34" Margin="0,0,10,0" Click="OpenWebsiteButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="100" Height="34" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
