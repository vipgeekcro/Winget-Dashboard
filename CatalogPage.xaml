<UserControl x:Class="WingetDashboard.CatalogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             KeyboardNavigation.TabNavigation="Cycle">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="BackButton"
                Grid.Row="0"
                Content="Back to Dashboard"
                HorizontalAlignment="Left"
                MinWidth="150"
                Height="34"
                Padding="14,5"
                Margin="0,0,0,14"
                automation:AutomationProperties.Name="Back to Dashboard"
                Click="BackButton_Click"/>

        <TextBlock x:Name="TitleText" Grid.Row="1"
                   Text="Winget Catalog"
                   FontSize="30"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,22">
            <TextBlock x:Name="StatusText" FontSize="16" Margin="0,0,0,8"
                       Focusable="True"/>
            <TextBlock x:Name="UpdatedText" FontSize="16" Margin="0,0,0,8"
                       Focusable="True"/>
            <TextBlock x:Name="PackagesText" FontSize="16"
                       Focusable="True"/>
        </StackPanel>

        <Button x:Name="UpdateCatalogButton"
                Grid.Row="3"
                Content="Update Catalog"
                HorizontalAlignment="Left"
                MinWidth="140"
                Height="34"
                Padding="18,5"
                automation:AutomationProperties.Name="Update Catalog"
                Click="UpdateCatalogButton_Click"/>
    </Grid>
</UserControl>
