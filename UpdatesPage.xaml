<UserControl x:Class="WingetDashboard.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="False"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <Style x:Key="StrongCheckBoxFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                BorderThickness="3" CornerRadius="2" Margin="-4">
                            <AdornedElementPlaceholder/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UpdateCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StrongCheckBoxFocus}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Updates" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBlock x:Name="StatusText" Grid.Row="1"
                   Text="Checking for available updates. Please wait."
                   Margin="0,0,0,10" FontSize="15"
                   Focusable="True" KeyboardNavigation.IsTabStop="True"
                   automation:AutomationProperties.LiveSetting="Polite"/>

        <!-- Accessible Windows Toolkit pattern: real WPF CheckBoxes own keyboard focus.
             Up/Down moves between CheckBoxes; Space is the native CheckBox toggle. -->
        <Border Grid.Row="2" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Padding="10" Margin="0,0,0,12">
            <ScrollViewer x:Name="UpdatesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel x:Name="UpdatesPanel"/>
            </ScrollViewer>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,0,0,10">
            <Button x:Name="SelectAllButton" Content="Select _all" MinWidth="120" Margin="0,0,8,0" Padding="10,6"
                    Click="SelectAllButton_Click"/>
            <Button x:Name="DeselectAllButton" Content="_Deselect all" MinWidth="120" Margin="0,0,8,0" Padding="10,6"
                    Click="DeselectAllButton_Click"/>
            <Button x:Name="UpdateSelectedButton" Content="Update _selected" MinWidth="145" Margin="0,0,8,0" Padding="10,6"
                    Click="UpdateSelectedButton_Click"/>
            <Button x:Name="UpdateAllButton" Content="_Update all" MinWidth="120" Padding="10,6"
                    Click="UpdateAllButton_Click"/>
        </WrapPanel>

        <Button x:Name="BackButton" Grid.Row="4" Content="_Back to Dashboard" HorizontalAlignment="Left"
                MinWidth="160" Padding="10,6" Click="BackButton_Click"/>
    </Grid>
</UserControl>
